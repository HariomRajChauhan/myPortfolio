PORT=5000
MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/hariom-portfolio?retryWrites=true&w=majority
JWT_SECRET=generate-a-long-random-secret-with-at-least-32-characters
NODE_ENV=development
# Comma-separated frontend URLs allowed to call this API. This is configured
# on the API host, not in MongoDB Atlas. A '*' matches any host, e.g.
# https://*.netlify.app allows all Netlify deploy previews.
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend-domain.example

# Number of proxy hops to trust for req.ip / rate limiting. Render terminates
# TLS in front of the app, so 1 is correct there. Leave unset for the default.
TRUST_PROXY=1

# Optional: raises GitHub API rate limit from 60 to 5,000 requests/hour.
# Use a fine-grained token with read-only public repository metadata access.
GITHUB_USERNAME=HariomRajChauhan
GITHUB_TOKEN=

# Optional: image storage. When all three Cloudinary values are set, uploads go
# to Cloudinary and only the URL is stored in MongoDB. When any is missing the
# API falls back to storing base64 images in MongoDB, which works but inflates
# the database and serves images through this API.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hariom-portfolio

# First-admin setup: POST /api/auth/register is allowed only while no admin
# account exists. Create one after deployment, then registration closes.
