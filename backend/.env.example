PORT=5000
MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/hariom-portfolio?retryWrites=true&w=majority
JWT_SECRET=generate-a-long-random-secret-with-at-least-32-characters
NODE_ENV=development
# Comma-separated frontend URLs allowed to call this API. This is configured
# on the API host, not in MongoDB Atlas.
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend-domain.example

# Optional: raises GitHub API rate limit from 60 to 5,000 requests/hour.
# Use a fine-grained token with read-only public repository metadata access.
GITHUB_USERNAME=HariomRajChauhan
GITHUB_TOKEN=

# First-admin setup: POST /api/auth/register is allowed only while no admin
# account exists. Create one after deployment, then registration closes.
